# OAuth Configuration
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8080/api/auth/linkedin/callback

# Voyager API Configuration (cookie-based authentication)
# Get these from your browser's LinkedIn session
# 1. li_at cookie: Main authentication cookie
# 2. JSESSIONID: Session ID for CSRF protection
LINKEDIN_LI_AT_COOKIE=
LINKEDIN_JSESSIONID=